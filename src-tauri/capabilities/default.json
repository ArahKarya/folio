{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions shared by every platform.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:webview:allow-internal-toggle-devtools",
    "os:allow-platform",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    }
  ]
}
